digraph G {
compound=true;
newrank=true;
graph [rotate=90]
subgraph clusterLegend {
legendBB[label="Basic Block",shape=oval]
;
legendBBEntry[label="Entry Node",shape=oval,style=bold]
;
legendRegion[label="Control Region",shape=box,color=blue]
;
legend1[shape=point]
;
legend2[shape=point]
;
