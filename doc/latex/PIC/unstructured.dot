;
legend3[shape=point]
;
legend4[shape=point]
;
legend3->legend4[label="Loop exit edge",dir=forward,arrowhead=vee,arrowtail=none,color=orange,style=bold]
;
legend5[shape=point]
;
legend6[shape=point]
;
legend5->legend6[label="Break edge",dir=forward,arrowhead=vee,arrowtail=none,color=red,style=bold]
;
}

